{
  "name": "micro-assistente",
  "version": "0.1.0",
  "private": true,
  "description": "Agente inteligente leve para tarefas locais com IA local, plugins e memória HAG",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n core,ui -c blue,green \"npm run dev:core\" \"npm run dev:ui\"",
    "dev:core": "npm run dev -w @micro-assistente/core",
    "dev:ui": "npm run dev -w @micro-assistente/ui",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
