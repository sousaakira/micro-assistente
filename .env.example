# ── LLM ──────────────────────────────────────────────────────
# Provedor: llama-cpp | ollama | openai (OmniRouter futuro)
LLM_PROVIDER=llama-cpp

# llama-cpp server (OpenAI-compatível em /v1/chat/completions)
LLM_BASE_URL=https://ia.lo
LLM_MODEL=Gemma-4-E2B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf
LLM_MAX_TOKENS=2048

# Opcional — llama-cpp com --api-key ou OmniRouter
# LLM_API_KEY=

# ── OmniRouter (futuro) ──────────────────────────────────────
# Troque o provider e aponte para o gateway:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://seu-omnirouter.local
# LLM_API_KEY=sua-chave

# ── Ollama (alternativa) ─────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=gemma2:9b

# ── Persistência ─────────────────────────────────────────────
TASKS_DB_PATH=./data/tasks.db
CHAT_DB_PATH=./data/chat.db
HAG_ENABLED=true
HAG_PATH=./data/hag

# ── WhatsApp (AkiraBrain) ────────────────────────────────────
AKIRA_BRAIN_PATH=/home/akira/Documents/Desenvolvimentos/AkiraBrain
WHATSAPP_WHATSMEOW_URL=http://127.0.0.1:5000
WHATSAPP_AKIRA_BRAIN_URL=http://127.0.0.1:8765
WHATSAPP_TIMEOUT_MS=25000

# ── API do agente ────────────────────────────────────────────
AGENT_PORT=3847
AGENT_HOST=127.0.0.1

# ── UI ───────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:3847

# ── Certificado auto-assinado (se ia.lo usar HTTPS local) ────
# NODE_TLS_REJECT_UNAUTHORIZED=0
